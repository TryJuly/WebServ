# ERREUR : code de error_page non numerique ("notfound" au lieu d'un entier)
# Le premier argument de error_page doit etre un code HTTP entier valide.
# Une chaine de caracteres doit etre rejetee.

server {
    listen 8080;
    server_name localhost;
    root ./var/www/html;
    index index.html;
    client_max_body_size 1048576;

    error_page notfound ./var/www/errors/404.html;

    location / {
        methods GET;
        autoindex off;
    }
}
