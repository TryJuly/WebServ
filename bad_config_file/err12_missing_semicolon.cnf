# ERREUR : point-virgule manquant apres une directive
# "root ./var/www/html" sans ';' doit etre detecte par le parser.

server {
    listen 8080;
    server_name localhost;
    root ./var/www/html
    index index.html;
    client_max_body_size 1048576;

    error_page 404 ./var/www/errors/404.html;

    location / {
        methods GET;
        autoindex off
    }
}
