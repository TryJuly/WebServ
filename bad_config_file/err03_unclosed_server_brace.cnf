# ERREUR : accolade ouvrante du bloc server jamais fermee
# Le parser doit detecter un bloc non ferme en fin de fichier.

server {
    listen 8080;
    server_name localhost;
    root ./var/www/html;
    index index.html;
    client_max_body_size 1048576;

    error_page 404 ./var/www/errors/404.html;

    location / {
        methods GET;
        autoindex off;
    }

# accolade fermante du server manquante
