# ERREUR : directive 'listen' placee dans un bloc location (mauvaise section)
# 'listen' est une directive de niveau server — elle est invalide dans location.
# Le parser doit rejeter une directive de contexte superieur dans un sous-bloc.

server {
    listen 8080;
    server_name localhost;
    root ./var/www/html;
    index index.html;
    client_max_body_size 1048576;

    error_page 404 ./var/www/errors/404.html;

    location / {
        listen 9090;
        methods GET;
        autoindex off;
    }
}
