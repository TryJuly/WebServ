# ERREUR : directives ecrites en dehors de tout bloc server
# "root" et "index" avant l'accolade ouvrante du server sont hors contexte.
# Tout token qui n'est pas "server {" au niveau racine doit etre rejete.

root ./var/www/html;
index index.html;

server {
    listen 8080;
    server_name localhost;
    root ./var/www/html;
    index index.html;
    client_max_body_size 1048576;

    error_page 404 ./var/www/errors/404.html;

    location / {
        methods GET;
        autoindex off;
    }
}
