server {
    listen 8080;
    server_name localhost;
    root ./var/www/;
    index index.html;
    client_max_body_size 1048576;

    error_page 404 ./var/www/errors/404.html;
  
    location / {
        methods GET;
        autoindex off;
    }

    location /cgi-bin {
        methods GET;
        autoindex off;
        cgi .py /usr/bin/python3;
    }
}