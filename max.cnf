server {
    listen 8080;
    server_name localhost;
    root ./var/www/html;
    client_max_body_size 1048576;

    error_page 404 ./var/www/errors/404.html;
    error_page 405 ./var/www/errors/405.html;
    error_page 500 ./var/www/errors/500.html;

    location / {
        index index.html;
        methods GET;
        autoindex off;
    }

    location /uploads {
        methods GET POST;
        upload_path ./var/www/uploads;
        autoindex off;
    }

    location /files {
        methods GET DELETE;
        autoindex on;
        root ./var/www;
    }

    location /cgi-bin {
        methods GET POST;
        cgi .py /usr/bin/python3;
    }

    location /old {
        redirect 301 /;
    }
}

server {
    listen 8081;
    server_name test.local;
    root ./var/www/test;
    client_max_body_size 512;

    error_page 404 ./var/www/errors/404.html;

    location / {
        index index.html;
        methods GET;
        autoindex on;
    }

    location /api {
        methods GET POST DELETE;
        autoindex off;
    }
}

server {
    listen 8082;
    server_name admin.local;
    root ./var/www/admin;
    client_max_body_size 2097152;

    error_page 403 ./var/www/errors/403.html;
    error_page 404 ./var/www/errors/404.html;
    error_page 405 ./var/www/errors/405.html;

    location / {
        index dashboard.html;
        methods GET;
        autoindex off;
    }

    location /uploads {
        methods POST;
        upload_path ./var/www/admin/uploads;
    }

    location /cgi-bin {
        methods GET POST;
        cgi .py /usr/bin/python3;
        cgi .php /usr/bin/php-cgi;
    }
}

server {
    listen 8083;
    server_name static.local;
    root ./var/www/static;
    client_max_body_size 1048576;

    location / {
        index index.html;
        methods GET;
        autoindex on;
    }

    location /redirect {
        redirect 301 /;
    }
}

server {
    listen 8084;
    server_name media.local;
    root ./var/www/media;
    client_max_body_size 10485760;

    error_page 404 ./var/www/errors/404.html;
    error_page 500 ./var/www/errors/500.html;

    location / {
        index index.html;
        methods GET;
        autoindex on;
    }

    location /uploads {
        methods GET POST;
        upload_path ./var/www/media/uploads;
    }

    location /cgi-bin {
        methods GET POST;
        cgi .py /usr/bin/python3;
    }
}