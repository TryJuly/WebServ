server {
    listen 8080;
    server_name localhost;
    root /var/www/html;
    index index.html;
    client_max_body_size 1048576;

    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;

    location / {
        methods GET;
        autoindex off;
        index /hello/MAN;
    }

    location /upload {
        methods GET POST;
        upload_path /var/www/uploads;
    }

    location /old {
        redirect 301 /new;
    }

    location /cgi-bin {
        methods GET POST;
        cgi .py /usr/bin/python3;
    }
}

